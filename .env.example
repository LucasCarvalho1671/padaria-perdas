# Banco de dados (copiar a connection string do Neon.tech)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo para gerar os tokens de login (pode ser qualquer texto longo)
JWT_SECRET=troque-por-uma-frase-secreta-longa-aqui

# Porta do servidor (deixar 3000 para desenvolvimento local)
PORT=3000
